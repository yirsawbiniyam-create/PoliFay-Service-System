rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Departments
    match /departments/{departmentId} {
      allow read, write: if true;
    }

    // Staff (Police officers)
    match /staff/{staffId} {
      allow read, write: if true;
    }

    // Attendance records (Staff check-in / check-out)
    match /attendance/{attendanceId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // Visitors (Fayda Digital ID records)
    match /visitors/{visitorId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // Feedbacks (Visitor 1-5 ratings & satisfaction metrics)
    match /feedbacks/{feedbackId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    // Settings (Branding, Logos, Flags & Work Hours)
    match /settings/{settingsId} {
      allow read, write: if true;
    }

    // Police Digital ID Registry (from Benishangul-Gumuz Police ID System)
    match /ids/{id} {
      allow read, write: if true;
    }

    // Scans & Verification logs
    match /scans/{scanId} {
      allow read, create: if true;
      allow update, delete: if false;
    }
  }
}

