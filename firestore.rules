rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.:]+$');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Departments
    match /departments/{departmentId} {
      allow read: if true;
      allow write: if isValidId(departmentId) &&
        request.resource.data.name is string && request.resource.data.name.size() <= 200 &&
        request.resource.data.code is string && request.resource.data.code.size() <= 50;
    }

    // Staff
    match /staff/{staffId} {
      allow read: if true;
      allow write: if isValidId(staffId) &&
        request.resource.data.fullName is string && request.resource.data.fullName.size() <= 150 &&
        request.resource.data.badgeNumber is string && request.resource.data.badgeNumber.size() <= 100;
    }

    // Attendance
    match /attendance/{attendanceId} {
      allow read: if true;
      allow create: if isValidId(attendanceId) &&
        request.resource.data.staffName is string && request.resource.data.staffName.size() <= 150 &&
        request.resource.data.badgeNumber is string && request.resource.data.badgeNumber.size() <= 100;
      allow update: if isValidId(attendanceId);
      allow delete: if false;
    }

    // Visitors (Fayda Digital ID entries)
    match /visitors/{visitorId} {
      allow read: if true;
      allow create: if isValidId(visitorId) &&
        request.resource.data.fullName is string && request.resource.data.fullName.size() <= 150 &&
        request.resource.data.faydaId is string && request.resource.data.faydaId.size() <= 100;
      allow update: if isValidId(visitorId);
      allow delete: if false;
    }

    // Feedbacks (Visitor satisfaction ratings)
    match /feedbacks/{feedbackId} {
      allow read: if true;
      allow create: if isValidId(feedbackId) &&
        request.resource.data.score is number && request.resource.data.score >= 1 && request.resource.data.score <= 5 &&
        request.resource.data.departmentId is string && request.resource.data.departmentId.size() <= 100;
      allow update: if false;
      allow delete: if false;
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isValidId(announcementId) &&
        request.resource.data.title is string && request.resource.data.title.size() <= 200 &&
        request.resource.data.message is string && request.resource.data.message.size() <= 1000;
    }

    // Settings
    match /settings/{settingsId} {
      allow read: if true;
      allow write: if isValidId(settingsId) &&
        request.resource.data.commissionName is string && request.resource.data.commissionName.size() <= 200;
    }
  }
}
